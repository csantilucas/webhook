# Porta em que o serviço escutará (padrão 4100)
PORT=4000

# Segredo do webhook gerado pelo Ágora (whsec_...) - OBRIGATÓRIO
# Fornecido ao criar o bot com endereço ou o webhook na tela de Integrações
AGORA_WEBHOOK_SECRET=whsec_exemplo_copie_do_agora

# Token do bot gerado pelo Ágora (bot_...)
# Deixe vazio para rodar em modo seco (dry-run, apenas loga a resposta)
AGORA_BOT_TOKEN=bot_exemplo_copie_do_agora

# URL base da API do Ágora (padrão https://api.agora.fslab.dev)
AGORA_URL=https://api.agora.fslab.dev

# Configurações da fila de retentativas
MAX_TENTATIVAS=5
ATRASO_BASE_MS=1000
